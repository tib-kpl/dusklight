/* French labels must remain readable on handheld screens at Android's DPI scale. */
window content pane {
    padding: var(--space-lg);
}

window content pane select-button key {
    flex: 1 1 0;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    text-transform: none;
    line-height: 1.25;
}

window content pane select-button value {
    flex: 0 0 35%;
    max-width: 45%;
    white-space: normal;
    word-break: break-word;
    overflow: visible;
    text-overflow: clip;
    font-size: var(--font-size-xl);
    line-height: 1.25;
}

window content pane select-button.editing value {
    display: none;
}

window content pane select-button input {
    flex: 0 0 35%;
    min-width: 0;
    max-width: 45%;
    font-size: var(--font-size-xl);
}

/* Preserve accented letters instead of relying on ASCII-only uppercasing. */
tab-bar,
section-heading,
#menu-list button,
footer-button {
    text-transform: none;
}

window tab-bar tab {
    padding: 0 var(--space-md);
}

window tab-bar[closable] {
    padding-right: var(--toolbar-height);
}

window tab-bar[closable] tab-end-spacer {
    display: none;
}

tuner-title {
    flex: 1 1 0;
    min-width: 0;
    white-space: normal;
}

@media (max-width: 640dp) {
    window content pane select-button:not(.group-button) {
        flex-wrap: wrap;
    }

    window content pane select-button:not(.group-button) key {
        flex: 1 1 100%;
    }

    window content pane select-button:not(.group-button) value {
        flex: 0 0 100%;
        max-width: 100%;
        text-align: left;
    }

    window content pane select-button input {
        flex: 0 0 100%;
        max-width: 100%;
        text-align: left;
    }
}

@media (max-width: 768dp) {
    window tab-bar {
        flex: 0 0 auto;
        flex-wrap: wrap;
        height: auto;
        min-height: var(--toolbar-height);
        align-items: center;
        overflow: visible;
    }

    window tab-bar tab {
        line-height: 48dp;
    }
}
